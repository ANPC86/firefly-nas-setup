# Copy to .env. Keep .env out of version control (the root .gitignore already ignores it).

# --- Ports on the host ---
FIREFLY_PORT=8080
IMPORTER_PORT=8081

# --- Identity ---
TZ=America/Edmonton
# The URL your BROWSER uses. Also what the importer's links point at (VANITY_URL).
# Behind a reverse proxy: https://firefly.example.lan  — and set TRUSTED_PROXIES=** below.
APP_URL=http://<nas-ip>:8080
TRUSTED_PROXIES=**

# --- Secrets. Generate real values BEFORE the first `up`; APP_KEY cannot be changed later
#     without losing access to encrypted fields. ---
# Exactly 32 characters:  head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32
APP_KEY=<exactly 32 random characters>
# Exactly 32 characters, same recipe. This is the secret in the daily cron URL.
STATIC_CRON_TOKEN=<exactly 32 random characters>

# --- Database (the app user; there is deliberately no root password) ---
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=<random>

# --- Data Importer. Leave empty on first start; fill in after creating a Personal Access Token
#     under Options → Profile → OAuth in Firefly, then `docker compose up -d importer`. ---
FIREFLY_III_ACCESS_TOKEN=

# --- Backup sidecar (--profile backup) ---
BACKUP_KEEP_DAYS=14
