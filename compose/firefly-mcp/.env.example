# Copy to .env. Keep this file out of version control — it holds a Firefly Personal Access Token.

# Where the MCP server finds Firefly. Container name on the shared network, scheme included.
FIREFLY_URL=http://firefly_iii_core:8080

# A Personal Access Token for the ONE Firefly user this server represents.
# Create it in Firefly under Options → Profile → OAuth → Personal Access Tokens.
# Clients present the same kind of token as "Authorization: Bearer ..." (HTTP + PAT mode).
FIREFLY_TOKEN=<personal access token>

# true  = every read tool, no create/update/delete. Start here.
# false = the full tool set, including writes. Only for the user whose data an assistant is
#         allowed to change, and only once you have a write procedure you trust (see agent/).
MCP_READ_ONLY=true

# Which tool groups load. "default" is what the reference setup runs.
MCP_PRESET=default
